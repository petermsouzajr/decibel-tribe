generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id                             String                          @id @default(cuid())
  username                       String                          @unique
  displayName                    String
  email                          String?                         @unique
  passwordHash                   String?
  isEmailVerified                Boolean                         @default(false)
  /// Soft ban flag for quick enforcement (source of truth is ModerationBan)
  isBanned                       Boolean                         @default(false) @map("is_banned")
  bannedAt                       DateTime?                       @map("banned_at")
  googleId                       String?                         @unique
  avatarUrl                      String?
  bio                            String?
  createdAt                      DateTime                        @default(now())
  pendingEmail                   String?
  deletedAt                      DateTime?
  isDatingActive                 Boolean                         @default(false)
  isAdmin                        Boolean                         @default(false)
  preferredUnits                 String?                         @default("metric")
  EmailVerification              EmailVerification[]
  groups                         GroupMember[]
  userInstruments                UserInstrument[]
  userSkills                     UserSkill[]
  bookmarks                      Bookmark[]
  commentLikes                   CommentLike[]
  comments                       Comment[]
  dislikes                       Dislike[]
  EventAttendee                  EventAttendee[]
  events                         Event[]                         @relation("CreatedEvents")
  following                      Follow[]                        @relation("Following")
  followers                      Follow[]                        @relation("Followers")
  ownedGroups                    Group[]                         @relation("GroupOwner")
  likes                          Like[]
  matchesAsUser1                 Match[]                         @relation("matches_user1IdTousers")
  matchesAsUser2                 Match[]                         @relation("matches_user2IdTousers")
  issuedNotifications            Notification[]                  @relation("Issuer")
  receivedNotifications          Notification[]                  @relation("Recipient")
  posts                          Post[]
  sessions                       Session[]
  swipesFromUser                 Swipe[]                         @relation("swipes_fromUserIdTousers")
  swipesToUser                   Swipe[]                         @relation("swipes_toUserIdTousers")
  userDatingPreferences          UserDatingPreferences?
  userDatingProfile              UserDatingProfile?
  userDatingIdentityVerification UserDatingIdentityVerification?
  userDatingPhotos               UserDatingPhoto[]
  userPreferences                UserPreferences?
  sentMessages                   Message[]                       @relation("MessageSender")

  // Reports relations
  reportsMade          Report[] @relation("UserReports")
  reportsReceived      Report[] @relation("ReportedUser")
  adminResolvedReports Report[] @relation("AdminResolutions")

  // Moderation (future use)
  moderationReportsMade        ModerationReport[]      @relation("ModerationReportsMade")
  moderationReportsReceived    ModerationReport[]      @relation("ModerationReportsReceived")
  moderationReportsReviewed    ModerationReport[]      @relation("ModerationReportsReviewedBy")
  moderationBans               ModerationBan[]         @relation("ModerationBannedUser")
  moderationBansIssued         ModerationBan[]         @relation("ModerationBansIssuedBy")
  moderationAppeals            ModerationAppeal[]      @relation("ModerationAppeals")
  moderationAppealsReviewed    ModerationAppeal[]      @relation("ModerationAppealsReviewedBy")
  moderationActionsAsActor     ModerationActionLog[]   @relation("ModerationActionActor")
  moderationActionsAsTarget    ModerationActionLog[]   @relation("ModerationActionTarget")

  // Blocking relations
  blocksMade     Block[] @relation("BlocksByUser")
  blocksReceived Block[] @relation("BlocksOfUser")

  @@index([isEmailVerified, isDatingActive, deletedAt])
  @@index([isDatingActive, deletedAt])
  @@map("users")
}

model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     GroupMember[]
  owner       User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  posts       Post[]

  // Reports
  reports Report[]

  @@map("groups")
}

model GroupMember {
  id             String    @id @default(cuid())
  userId         String
  groupId        String
  role           GroupRole @default(MEMBER)
  acceptedInvite Boolean   @default(false)
  joinedAt       DateTime  @default(now())
  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreferences {
  id       String @id @default(cuid())
  calendar String @default("PUBLIC")
  /// Private profile zip code (only visible to account owner)
  zipCode   String?
  /// Private cached geocode latitude for zipCode
  latitude  Float?
  /// Private cached geocode longitude for zipCode
  longitude Float?
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserSkill {
  userId  String
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model UserInstrument {
  userId       String
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, instrumentId])
}

model Skill {
  id    String      @id @default(cuid())
  name  String      @unique
  users UserSkill[]
  eventHelpWanted EventHelpWantedSkill[]
}

model Instrument {
  id    String           @id @default(cuid())
  name  String           @unique
  users UserInstrument[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Reports for content moderation
enum ReportReason {
  HARASSMENT
  VIOLENCE
  SPAM
  INAPPROPRIATE_CONTENT
  FAKE_PROFILE
  OTHER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED_ACTION_TAKEN
  RESOLVED_NO_ACTION
  DISMISSED
}

model Report {
  id         String  @id @default(cuid())
  reporterId String
  reportedId String?
  postId     String?
  commentId  String?
  messageId  String?
  groupId    String?
  eventId    String?

  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)
  adminNotes  String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  resolvedBy String?

  reporter User     @relation("UserReports", fields: [reporterId], references: [id])
  reported User?    @relation("ReportedUser", fields: [reportedId], references: [id])
  post     Post?    @relation(fields: [postId], references: [id])
  comment  Comment? @relation(fields: [commentId], references: [id])
  group    Group?   @relation(fields: [groupId], references: [id])
  event    Event?   @relation(fields: [eventId], references: [id])
  admin    User?    @relation("AdminResolutions", fields: [resolvedBy], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("reports")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Post {
  id                  String         @id @default(cuid())
  content             String
  userId              String
  createdAt           DateTime       @default(now())
  // @default(now()) so the column can be added to existing rows; @updatedAt
  // keeps it current on every write. Matches how Comment and Group declare it.
  updatedAt           DateTime       @default(now()) @updatedAt
  groupId             String?
  // Sharing
  sharedFromId        String?
  sharedCount         Int            @default(0)
  bookmarks           Bookmark[]
  comments            Comment[]
  dislikes            Dislike[]
  likes               Like[]
  linkedNotifications Notification[]
  attachments         Media[]
  Group               Group?         @relation(fields: [groupId], references: [id])
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedFrom          Post?          @relation("PostShares", fields: [sharedFromId], references: [id])
  shares              Post[]         @relation("PostShares")

  // Reports
  reports Report[]

  @@map("posts")
}

model Media {
  id        String    @id @default(cuid())
  postId    String?
  type      MediaType
  url       String
  createdAt DateTime  @default(now())
  post      Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_media")
}

model Comment {
  id        String        @id @default(cuid())
  content   String
  userId    String
  postId    String
  createdAt DateTime      @default(now())
  deletedAt DateTime?
  editedAt  DateTime?
  isDeleted Boolean       @default(false)
  isEdited  Boolean       @default(false)
  parentId  String?
  updatedAt DateTime      @default(now()) @updatedAt
  likes     CommentLike[]
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[]     @relation("CommentReplies")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports   Report[]

  @@map("comments")
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  isLike    Boolean
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model Like {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

model Dislike {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("dislikes")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("bookmarks")
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksByUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksOfUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("blocks")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  issuerId    String
  postId      String?
  type        NotificationType
  read        Boolean          @default(false)
  eventId     String?
  matchId     String? // Link to match for MATCH type notifications
  createdAt   DateTime         @default(now())
  event       Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  issuer      User             @relation("Issuer", fields: [issuerId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  match       Match?           @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([recipientId, eventId, type])
  @@map("notifications")
}

model Event {
  id                  String          @id @default(cuid())
  title               String
  location            String
  description         String?
  url                 String?
  startTime           String
  endTime             String
  performers          String[]
  /// Optional: if set, used for proximity search (not displayed publicly)
  zipCode             String?
  /// Cached geocode latitude (not displayed publicly)
  latitude            Float?
  /// Cached geocode longitude (not displayed publicly)
  longitude           Float?
  createdById         String
  isCancelled         Boolean         @default(false)
  status              String          @default("DRAFT")
  visibility          String          @default("PUBLIC")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  when                DateTime
  attendees           EventAttendee[]
  createdBy           User            @relation("CreatedEvents", fields: [createdById], references: [id])
  linkedNotifications Notification[]
  helpWantedSkills    EventHelpWantedSkill[]

  // Reports
  reports Report[]

  @@index([zipCode])
  @@index([latitude, longitude])
  @@map("events")
}

/// Join table: which skills an event is recruiting for (help wanted)
model EventHelpWantedSkill {
  eventId String
  skillId String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([eventId, skillId])
  @@index([skillId])
  @@map("event_help_wanted_skills")
}

model EventAttendee {
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@map("event_attendees")
}

model Match {
  id                String         @id
  user1Id           String
  user2Id           String
  createdAt         DateTime       @default(now())
  user1LastViewedAt DateTime? // When user1 last viewed this match
  user2LastViewedAt DateTime? // When user2 last viewed this match
  user1             User           @relation("matches_user1IdTousers", fields: [user1Id], references: [id], onDelete: Cascade)
  user2             User           @relation("matches_user2IdTousers", fields: [user2Id], references: [id], onDelete: Cascade)
  messages          Message[]
  notifications     Notification[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([user1Id, createdAt])
  @@index([user2Id, createdAt])
  @@map("matches")
}

model Swipe {
  id            String    @id
  fromUserId    String
  toUserId      String
  direction     String
  message       String? // Optional message with like
  undoExpiresAt DateTime? // For undo functionality (3-hour window)
  createdAt     DateTime  @default(now())
  fromUser      User      @relation("swipes_fromUserIdTousers", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser        User      @relation("swipes_toUserIdTousers", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([fromUserId, createdAt])
  @@index([direction, createdAt])
  @@map("swipes")
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  senderId  String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender    User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@map("messages")
}

model UserDatingProfile {
  id                    String    @id
  userId                String    @unique
  age                   Int?
  height                Int? // Height in inches (no decimals)
  gender                String?
  sexualOrientation     String?
  coronavirusVaccinated String?
  religion              String?
  bodyType              String? // See BODY_TYPE_OPTIONS values
  bio                   String?
  hasKids               Boolean?
  wantsKids             String? // "yes" | "no" | "maybe" | "not_sure" - future kids preference
  smokes                String? // "Yes" | "No" | "Social"
  drinks                String? // "Yes" | "No" | "Social"
  activity              String? // "Active" | "Sporting" | "Super active" | "Couch potato" | "Hiker" | etc.
  education             String? // "high_school" | "some_college" | "bachelors" | "masters" | "phd" | "professional"
  job                   String?   @db.VarChar(100)
  politicalViews        String? // "liberal" | "moderate" | "conservative" | "apolitical" | "other"
  diet                  String? // "omnivore" | "vegetarian" | "vegan" | "pescatarian" | "kosher" | "halal" | "other"
  relationshipType      String? // "monogamous" | "ethical_non_monogamous" | "open_to_both"
  pets                  String[]  @default([]) // Multi-select
  interests             String[] // Array of interests like "Gamer", "Foodie", etc.
  createdAt             DateTime? @default(now()) @db.Timestamp(6)
  updatedAt             DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  zipCode               String? // User's zip code (input by user)
  city                  String? // City name (geocoded from zip code, displayed on card)
  latitude              Float? // Cached geocoded latitude (from zip code)
  longitude             Float? // Cached geocoded longitude (from zip code)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_dating_profiles")
}

model UserDatingIdentityVerification {
  id                    String    @id @default(cuid())
  userId                String    @unique
  isIDVerified          Boolean   @default(false)
  verificationStatus    String    @default("not_started") // "not_started" | "pending" | "verified" | "failed" | "requires_input"
  verificationMethod    String? // "stripe_identity" | "manual" | future methods
  stripeVerificationId  String?   @unique // Stripe Identity VerificationSession ID
  stripeVerificationUrl String? // URL for user to complete Stripe verification
  documentType          String? // "passport" | "drivers_license" | "id_card"
  verifiedAt            DateTime?
  failureReason         String? // Reason if verification failed
  attemptsCount         Int       @default(0)
  lastAttemptAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isIDVerified])
  @@index([stripeVerificationId])
  @@map("user_dating_identity_verifications")
}

model UserDatingPreferences {
  id                             String   @id
  userId                         String   @unique
  preferredMinAge                Int
  preferredMaxAge                Int
  preferredMaxDistanceKm         Int
  preferredMinHeight             Int? // Height in inches (no decimals)
  preferredMaxHeight             Int? // Height in inches (no decimals)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
  preferredCoronavirusVaccinated String?
  preferredReligions             String[]
  preferredGender                String?
  preferredSexualOrientation     String?
  preferredBodyType              String?
  preferredInstruments           String[] // Music filter: preferred instruments
  preferredSkills                String[] // Music filter: preferred skills
  matchMusicTastes               Boolean  @default(true) // User preference: prioritize instrument and skill match
  preferredHasKids               String? // "yes" | "no" | "any" | null
  preferredWantsKids             String? // "yes" | "no" | "maybe" | "any" | null - future kids preference
  preferredSmokes                String? // "Yes" | "No" | "Social" | null
  preferredDrinks                String? // "Yes" | "No" | "Social" | null
  preferredActivity              String[] // Activity level preference (multi-select)
  preferredEducation             String[] // Array of education levels
  preferredPoliticalViews        String[] // Array of political views
  preferredDiet                  String[] // Array of diet preferences
  preferredRelationshipType      String[] // Array of relationship types
  preferredPets                  String[] @default([]) // Pets preference (multi-select)
  // Mix It Up controls
  variabilityLevel               Int      @default(0) // 0-100% variability slider
  variabilityFilters             String[] // Array of filter names to include in variability (e.g., ["gender", "age", "distance", "height", "hasKids", "wantsKids", "smokes", "drinks", "vaccination", "relationshipType", "activity", "diet", "politicalViews", "education", "religion"])
  idVerificationFilter           String   @default("show_id_verified_only") // "show_id_verified_only" | "show_all" | "show_unverified_only"
  user                           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_dating_preferences")
}

model UserDatingPhoto {
  id        String    @id
  userId    String
  url       String
  isPrimary Boolean   @default(false)
  /// "Uploaded at" timestamp (historically used for uploads)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isPrimary])
  @@map("user_photos")
}

enum GroupRole {
  MEMBER
  ADMIN
}

enum MediaType {
  IMAGE
  VIDEO
}

enum NotificationType {
  DISLIKE
  LIKE
  FOLLOW
  COMMENT
  EVENT_ATTENDEE
  EVENT_CANCELLED
  MATCH
}

// ============================
// Moderation (future use)
// ============================

enum ModerationReportEntityType {
  USER
  POST
  PHOTO
  MESSAGE
}

enum ModerationReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTIONED
}

enum ModerationBanType {
  TEMPORARY
  PERMANENT
  SHADOW
}

enum ModerationBanStatus {
  ACTIVE
  EXPIRED
  APPEALED
  LIFTED
}

enum ModerationAppealStatus {
  PENDING
  APPROVED
  DENIED
}

model ModerationReport {
  id           String                 @id @default(cuid())
  reporterId   String
  /// For USER reports, this is the user being reported. For others it can be null.
  reportedUserId String?
  reportedType ModerationReportEntityType
  /// ID of the reported entity (userId/postId/photoId/messageId depending on reportedType)
  entityId     String
  /// Canonical reason string (e.g. "spam", "harassment", "nudity", "hate_speech")
  reason       String
  details      String?
  status       ModerationReportStatus @default(PENDING)
  /// Canonical action string (e.g. "warning", "temp_ban", "perm_ban", "content_removed", "shadowban")
  actionTaken  String?
  moderatorId  String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  reporter     User                   @relation("ModerationReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?                  @relation("ModerationReportsReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)
  moderator    User?                  @relation("ModerationReportsReviewedBy", fields: [moderatorId], references: [id], onDelete: SetNull)

  banLinks     ModerationBanReport[]

  @@index([reporterId])
  @@index([reportedUserId, reportedType])
  @@index([reportedType, entityId])
  @@index([status, createdAt])
  @@map("moderation_reports")
}

model ModerationBan {
  id           String             @id @default(cuid())
  userId       String
  reason       String
  banType      ModerationBanType  @default(TEMPORARY)
  durationDays Int?
  expiresAt    DateTime?
  status       ModerationBanStatus @default(ACTIVE)
  moderatorId  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user         User               @relation("ModerationBannedUser", fields: [userId], references: [id], onDelete: Cascade)
  moderator    User?              @relation("ModerationBansIssuedBy", fields: [moderatorId], references: [id], onDelete: SetNull)
  appeals      ModerationAppeal[]
  reportLinks  ModerationBanReport[]

  @@index([userId])
  @@index([userId, status])
  @@index([expiresAt])
  @@index([status])
  @@map("moderation_bans")
}

model ModerationBanReport {
  banId    String
  reportId String

  ban      ModerationBan   @relation(fields: [banId], references: [id], onDelete: Cascade)
  report   ModerationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@id([banId, reportId])
  @@index([reportId])
  @@map("moderation_ban_reports")
}

model ModerationAppeal {
  id             String               @id @default(cuid())
  banId          String
  userId         String
  details        String
  status         ModerationAppealStatus @default(PENDING)
  moderatorNotes String?
  reviewedById   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  ban            ModerationBan        @relation(fields: [banId], references: [id], onDelete: Cascade)
  user           User                 @relation("ModerationAppeals", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy     User?                @relation("ModerationAppealsReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([banId])
  @@index([userId])
  @@index([status])
  @@map("moderation_appeals")
}

model ModerationActionLog {
  id           String   @id @default(cuid())
  actorId      String?
  targetUserId String?
  action       String
  reason       String?
  metadata     Json?
  createdAt    DateTime @default(now())

  actor        User?    @relation("ModerationActionActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("ModerationActionTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("moderation_action_logs")
}
