generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                              String                   @id @default(cuid())
  username                        String                   @unique
  displayName                     String
  email                           String?                  @unique
  passwordHash                    String?
  isVerified                      Boolean                  @default(false)
  googleId                        String?                  @unique
  avatarUrl                       String?
  bio                             String?
  createdAt                       DateTime                 @default(now())
  pendingEmail                    String?
  deletedAt                       DateTime?
  isDatingActive                  Boolean                  @default(false)
  preferredUnits                  String?                  @default("metric")
  EmailVerification               EmailVerification[]
  groups                          GroupMember[]
  userInstruments                 UserInstrument[]
  userSkills                      UserSkill[]
  bookmarks                       Bookmark[]
  commentLikes                    CommentLike[]
  comments                        Comment[]
  dislikes                        Dislike[]
  EventAttendee                   EventAttendee[]
  events                          Event[]                  @relation("CreatedEvents")
  following                       Follow[]                 @relation("Following")
  followers                       Follow[]                 @relation("Followers")
  ownedGroups                     Group[]                  @relation("GroupOwner")
  likes                           Like[]
  matches_matches_user1IdTousers  matches[]                @relation("matches_user1IdTousers")
  matches_matches_user2IdTousers  matches[]                @relation("matches_user2IdTousers")
  issuedNotifications             Notification[]           @relation("Issuer")
  receivedNotifications           Notification[]           @relation("Recipient")
  posts                           Post[]
  sessions                        Session[]
  swipes_swipes_fromUserIdTousers swipes[]                 @relation("swipes_fromUserIdTousers")
  swipes_swipes_toUserIdTousers   swipes[]                 @relation("swipes_toUserIdTousers")
  user_dating_preferences         user_dating_preferences?
  user_dating_profile             user_dating_profile?
  user_photos                     user_photos[]
  userPreferences                 UserPreferences?

  @@map("users")
}

model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     GroupMember[]
  owner       User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  posts       Post[]

  @@map("groups")
}

model GroupMember {
  id             String    @id @default(cuid())
  userId         String
  groupId        String
  role           GroupRole @default(MEMBER)
  acceptedInvite Boolean   @default(false)
  joinedAt       DateTime  @default(now())
  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreferences {
  id       String @id @default(cuid())
  calendar String @default("PUBLIC")
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserSkill {
  userId  String
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model UserInstrument {
  userId       String
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, instrumentId])
}

model Skill {
  id    String      @id @default(cuid())
  name  String      @unique
  users UserSkill[]
}

model Instrument {
  id    String           @id @default(cuid())
  name  String           @unique
  users UserInstrument[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Post {
  id                  String         @id @default(cuid())
  content             String
  userId              String
  createdAt           DateTime       @default(now())
  groupId             String?
  bookmarks           Bookmark[]
  comments            Comment[]
  dislikes            Dislike[]
  likes               Like[]
  linkedNotifications Notification[]
  attachments         Media[]
  Group               Group?         @relation(fields: [groupId], references: [id])
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("posts")
}

model Media {
  id        String    @id @default(cuid())
  postId    String?
  type      MediaType
  url       String
  createdAt DateTime  @default(now())
  post      Post?     @relation(fields: [postId], references: [id])

  @@map("post_media")
}

model Comment {
  id        String        @id @default(cuid())
  content   String
  userId    String
  postId    String
  createdAt DateTime      @default(now())
  deletedAt DateTime?
  editedAt  DateTime?
  isDeleted Boolean       @default(false)
  isEdited  Boolean       @default(false)
  parentId  String?
  updatedAt DateTime      @default(now()) @updatedAt
  likes     CommentLike[]
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[]     @relation("CommentReplies")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  isLike    Boolean
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model Like {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

model Dislike {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("dislikes")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("bookmarks")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  issuerId    String
  postId      String?
  type        NotificationType
  read        Boolean          @default(false)
  eventId     String?
  createdAt   DateTime         @default(now())
  event       Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  issuer      User             @relation("Issuer", fields: [issuerId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, eventId, type])
  @@map("notifications")
}

model Event {
  id                  String          @id @default(cuid())
  title               String
  location            String
  description         String?
  url                 String?
  startTime           String
  endTime             String
  performers          String[]
  createdById         String
  isCancelled         Boolean         @default(false)
  status              String          @default("DRAFT")
  visibility          String          @default("PUBLIC")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  when                DateTime
  attendees           EventAttendee[]
  createdBy           User            @relation("CreatedEvents", fields: [createdById], references: [id])
  linkedNotifications Notification[]

  @@map("events")
}

model EventAttendee {
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@map("event_attendees")
}

model matches {
  id                           String   @id
  user1Id                      String
  user2Id                      String
  createdAt                    DateTime @default(now())
  users_matches_user1IdTousers User     @relation("matches_user1IdTousers", fields: [user1Id], references: [id], onDelete: Cascade)
  users_matches_user2IdTousers User     @relation("matches_user2IdTousers", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
}

model swipes {
  id                             String   @id
  fromUserId                     String
  toUserId                       String
  direction                      String
  createdAt                      DateTime @default(now())
  users_swipes_fromUserIdTousers User     @relation("swipes_fromUserIdTousers", fields: [fromUserId], references: [id], onDelete: Cascade)
  users_swipes_toUserIdTousers   User     @relation("swipes_toUserIdTousers", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
}

model user_dating_profile {
  id                    String    @id
  userId                String    @unique
  age                   Int?
  height                Float?    @db.Real
  gender                String?
  sexualOrientation     String?
  coronavirusVaccinated String?
  religion              String?
  createdAt             DateTime? @default(now()) @db.Timestamp(6)
  updatedAt             DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  location              String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_dating_preferences {
  id                             String   @id
  userId                         String   @unique
  preferredMinAge                Int
  preferredMaxAge                Int
  preferredMaxDistanceKm         Int
  preferredMinHeight             Float?
  preferredMaxHeight             Float?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
  preferredCoronavirusVaccinated String?
  preferredReligions             String[]
  preferredGender                String?
  preferredSexualOrientation     String?
  users                          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model user_photos {
  id        String   @id
  userId    String
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  users     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum GroupRole {
  MEMBER
  ADMIN
}

enum MediaType {
  IMAGE
  VIDEO
}

enum NotificationType {
  DISLIKE
  LIKE
  FOLLOW
  COMMENT
  EVENT_ATTENDEE
  EVENT_CANCELLED
}
