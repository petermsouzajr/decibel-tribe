generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                                String                             @id @default(cuid())
  username                          String                             @unique
  displayName                       String
  email                             String?                            @unique
  passwordHash                      String?
  isVerified                        Boolean                            @default(false)
  googleId                          String?                            @unique
  avatarUrl                         String?
  bio                               String?
  createdAt                         DateTime                           @default(now())
  pendingEmail                      String?
  deletedAt                         DateTime?
  isDatingActive                    Boolean                            @default(false)
  isAdmin                           Boolean                            @default(false)
  preferredUnits                    String?                            @default("metric")
  EmailVerification                 EmailVerification[]
  groups                            GroupMember[]
  userInstruments                   UserInstrument[]
  userSkills                        UserSkill[]
  bookmarks                         Bookmark[]
  commentLikes                      CommentLike[]
  comments                          Comment[]
  dislikes                          Dislike[]
  EventAttendee                     EventAttendee[]
  events                            Event[]                            @relation("CreatedEvents")
  following                         Follow[]                           @relation("Following")
  followers                         Follow[]                           @relation("Followers")
  ownedGroups                       Group[]                            @relation("GroupOwner")
  likes                             Like[]
  matches_matches_user1IdTousers    matches[]                          @relation("matches_user1IdTousers")
  matches_matches_user2IdTousers    matches[]                          @relation("matches_user2IdTousers")
  issuedNotifications               Notification[]                     @relation("Issuer")
  receivedNotifications             Notification[]                     @relation("Recipient")
  posts                             Post[]
  sessions                          Session[]
  swipes_swipes_fromUserIdTousers   swipes[]                           @relation("swipes_fromUserIdTousers")
  swipes_swipes_toUserIdTousers     swipes[]                           @relation("swipes_toUserIdTousers")
  user_dating_preferences           user_dating_preferences?
  user_dating_profile               user_dating_profile?
  user_dating_identity_verification user_dating_identity_verification?
  user_photos                       user_photos[]
  userPreferences                   UserPreferences?
  sentMessages                      Message[]                          @relation("MessageSender")
  datingLocationOverride            dating_location_overrides?         @relation("DatingLocationOverrides")

  // Reports relations
  reportsMade          Report[] @relation("UserReports")
  reportsReceived      Report[] @relation("ReportedUser")
  adminResolvedReports Report[] @relation("AdminResolutions")

  // Blocking relations
  blocksMade     Block[] @relation("BlocksByUser")
  blocksReceived Block[] @relation("BlocksOfUser")

  @@index([isVerified, isDatingActive, deletedAt])
  @@index([isDatingActive, deletedAt])
  @@map("users")
}

model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     GroupMember[]
  owner       User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  posts       Post[]

  // Reports
  reports Report[]

  @@map("groups")
}

model GroupMember {
  id             String    @id @default(cuid())
  userId         String
  groupId        String
  role           GroupRole @default(MEMBER)
  acceptedInvite Boolean   @default(false)
  joinedAt       DateTime  @default(now())
  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreferences {
  id       String @id @default(cuid())
  calendar String @default("PUBLIC")
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserSkill {
  userId  String
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model UserInstrument {
  userId       String
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, instrumentId])
}

model Skill {
  id    String      @id @default(cuid())
  name  String      @unique
  users UserSkill[]
}

model Instrument {
  id    String           @id @default(cuid())
  name  String           @unique
  users UserInstrument[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Reports for content moderation
enum ReportReason {
  HARASSMENT
  VIOLENCE
  SPAM
  INAPPROPRIATE_CONTENT
  FAKE_PROFILE
  OTHER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED_ACTION_TAKEN
  RESOLVED_NO_ACTION
  DISMISSED
}

model Report {
  id         String  @id @default(cuid())
  reporterId String
  reportedId String?
  postId     String?
  commentId  String?
  messageId  String?
  groupId    String?
  eventId    String?

  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)
  adminNotes  String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  resolvedBy String?

  reporter User     @relation("UserReports", fields: [reporterId], references: [id])
  reported User?    @relation("ReportedUser", fields: [reportedId], references: [id])
  post     Post?    @relation(fields: [postId], references: [id])
  comment  Comment? @relation(fields: [commentId], references: [id])
  group    Group?   @relation(fields: [groupId], references: [id])
  event    Event?   @relation(fields: [eventId], references: [id])
  admin    User?    @relation("AdminResolutions", fields: [resolvedBy], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("reports")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Post {
  id                  String         @id @default(cuid())
  content             String
  userId              String
  createdAt           DateTime       @default(now())
  groupId             String?
  // Sharing
  sharedFromId        String?
  sharedCount         Int            @default(0)
  bookmarks           Bookmark[]
  comments            Comment[]
  dislikes            Dislike[]
  likes               Like[]
  linkedNotifications Notification[]
  attachments         Media[]
  Group               Group?         @relation(fields: [groupId], references: [id])
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedFrom          Post?          @relation("PostShares", fields: [sharedFromId], references: [id])
  shares              Post[]         @relation("PostShares")

  // Reports
  reports Report[]

  @@map("posts")
}

model Media {
  id        String    @id @default(cuid())
  postId    String?
  type      MediaType
  url       String
  createdAt DateTime  @default(now())
  post      Post?     @relation(fields: [postId], references: [id])

  @@map("post_media")
}

model Comment {
  id        String        @id @default(cuid())
  content   String
  userId    String
  postId    String
  createdAt DateTime      @default(now())
  deletedAt DateTime?
  editedAt  DateTime?
  isDeleted Boolean       @default(false)
  isEdited  Boolean       @default(false)
  parentId  String?
  updatedAt DateTime      @default(now()) @updatedAt
  likes     CommentLike[]
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[]     @relation("CommentReplies")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports   Report[]

  @@map("comments")
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  isLike    Boolean
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model Like {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

model Dislike {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("dislikes")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("bookmarks")
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksByUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksOfUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("blocks")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  issuerId    String
  postId      String?
  type        NotificationType
  read        Boolean          @default(false)
  eventId     String?
  matchId     String? // Link to match for MATCH type notifications
  createdAt   DateTime         @default(now())
  event       Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  issuer      User             @relation("Issuer", fields: [issuerId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  match       matches?         @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([recipientId, eventId, type])
  @@map("notifications")
}

model Event {
  id                  String          @id @default(cuid())
  title               String
  location            String
  description         String?
  url                 String?
  startTime           String
  endTime             String
  performers          String[]
  createdById         String
  isCancelled         Boolean         @default(false)
  status              String          @default("DRAFT")
  visibility          String          @default("PUBLIC")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  when                DateTime
  attendees           EventAttendee[]
  createdBy           User            @relation("CreatedEvents", fields: [createdById], references: [id])
  linkedNotifications Notification[]

  // Reports
  reports Report[]

  @@map("events")
}

model EventAttendee {
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@map("event_attendees")
}

model matches {
  id                           String    @id
  user1Id                      String
  user2Id                      String
  createdAt                    DateTime  @default(now())
  user1LastViewedAt            DateTime? // When user1 last viewed this match
  user2LastViewedAt            DateTime? // When user2 last viewed this match
  users_matches_user1IdTousers User      @relation("matches_user1IdTousers", fields: [user1Id], references: [id], onDelete: Cascade)
  users_matches_user2IdTousers User      @relation("matches_user2IdTousers", fields: [user2Id], references: [id], onDelete: Cascade)
  messages                     Message[]
  notifications                Notification[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([user1Id, createdAt])
  @@index([user2Id, createdAt])
}

model swipes {
  id                             String    @id
  fromUserId                     String
  toUserId                       String
  direction                      String
  message                        String? // Optional message with like
  undoExpiresAt                  DateTime? // For undo functionality (3-hour window)
  createdAt                      DateTime  @default(now())
  users_swipes_fromUserIdTousers User      @relation("swipes_fromUserIdTousers", fields: [fromUserId], references: [id], onDelete: Cascade)
  users_swipes_toUserIdTousers   User      @relation("swipes_toUserIdTousers", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([fromUserId, createdAt])
  @@index([direction, createdAt])
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  senderId  String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  match     matches  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender    User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@map("messages")
}

model user_dating_profile {
  id                    String    @id
  userId                String    @unique
  age                   Int?
  height                Int? // Height in inches (no decimals)
  gender                String?
  sexualOrientation     String?
  coronavirusVaccinated String?
  religion              String?
  bio                   String?
  hasKids               Boolean?
  wantsKids             String? // "yes" | "no" | "maybe" | "not_sure" - future kids preference
  smokes                String? // "Yes" | "No" | "Social"
  drinks                String? // "Yes" | "No" | "Social"
  activity              String? // "Active" | "Sporting" | "Super active" | "Couch potato" | "Hiker" | etc.
  education             String? // "high_school" | "some_college" | "bachelors" | "masters" | "phd" | "professional"
  job                   String?   @db.VarChar(100)
  politicalViews        String? // "liberal" | "moderate" | "conservative" | "apolitical" | "other"
  diet                  String? // "omnivore" | "vegetarian" | "vegan" | "pescatarian" | "kosher" | "halal" | "other"
  relationshipType      String? // "monogamous" | "ethical_non_monogamous" | "open_to_both"
  pets                  String?   @db.VarChar(150)
  interests             String[] // Array of interests like "Gamer", "Foodie", etc.
  createdAt             DateTime? @default(now()) @db.Timestamp(6)
  updatedAt             DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  zipCode               String? // User's zip code (input by user)
  city                  String? // City name (geocoded from zip code, displayed on card)
  latitude              Float? // Cached geocoded latitude (from zip code)
  longitude             Float? // Cached geocoded longitude (from zip code)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_dating_identity_verification {
  id                    String    @id @default(cuid())
  userId                String    @unique
  isVerified            Boolean   @default(false)
  verificationStatus    String    @default("not_started") // "not_started" | "pending" | "verified" | "failed" | "requires_input"
  verificationMethod    String? // "stripe_identity" | "manual" | future methods
  stripeVerificationId  String?   @unique // Stripe Identity VerificationSession ID
  stripeVerificationUrl String? // URL for user to complete Stripe verification
  documentType          String? // "passport" | "drivers_license" | "id_card"
  verifiedAt            DateTime?
  failureReason         String? // Reason if verification failed
  attemptsCount         Int       @default(0)
  lastAttemptAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isVerified])
  @@index([stripeVerificationId])
  @@map("user_dating_identity_verifications")
}

model user_dating_preferences {
  id                             String   @id
  userId                         String   @unique
  preferredMinAge                Int
  preferredMaxAge                Int
  preferredMaxDistanceKm         Int
  preferredMinHeight             Int? // Height in inches (no decimals)
  preferredMaxHeight             Int? // Height in inches (no decimals)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
  preferredCoronavirusVaccinated String?
  preferredReligions             String[]
  preferredGender                String?
  preferredSexualOrientation     String?
  preferredInstruments           String[] // Music filter: preferred instruments
  preferredSkills                String[] // Music filter: preferred skills
  matchMusicTastes               Boolean  @default(true) // User preference: prioritize music compatibility
  preferredHasKids               String? // "yes" | "no" | "any" | null
  preferredWantsKids             String? // "yes" | "no" | "maybe" | "any" | null - future kids preference
  preferredSmokes                String? // "Yes" | "No" | "Social" | null
  preferredDrinks                String? // "Yes" | "No" | "Social" | null
  preferredActivity              String? // Activity level preference
  preferredEducation             String[] // Array of education levels
  preferredPoliticalViews        String[] // Array of political views
  preferredDiet                  String[] // Array of diet preferences
  preferredRelationshipType      String[] // Array of relationship types
  // Match strictness controls
  exactMatchAllFilters           Boolean  @default(false) // Strict matching: all preferences must match exactly
  minimumMatchPercentage         Int      @default(70) // Minimum compatibility percentage (0-100)
  nonNegotiableFields            String[] // Array of field names that are dealbreakers (e.g., ["smokes", "hasKids", "religion"])
  users                          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model user_photos {
  id        String   @id
  userId    String
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  users     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isPrimary])
}

model dating_location_overrides {
  id        String   @id @default(cuid())
  userId    String   @unique
  latitude  Float
  longitude Float
  city      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation("DatingLocationOverrides", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum GroupRole {
  MEMBER
  ADMIN
}

enum MediaType {
  IMAGE
  VIDEO
}

enum NotificationType {
  DISLIKE
  LIKE
  FOLLOW
  COMMENT
  EVENT_ATTENDEE
  EVENT_CANCELLED
  MATCH
}
