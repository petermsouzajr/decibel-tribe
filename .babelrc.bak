{
  "presets": ["next/babel"],
  "plugins": [],
  // Conditionally apply the istanbul plugin based on an environment variable
  // This prevents instrumenting production code. We use a specific env var
  // CYPRESS_INSTRUMENT, controlled via start-server-and-test, instead of NODE_ENV=test
  // to avoid instrumenting code during `next build` if NODE_ENV happens to be test.
  "env": {
    "instrumented": {
      "plugins": [
        [
          "istanbul",
          {
            // specify instrumentation options here
            // default is all options === false
            "useInlineSourceMaps": false // Recommended for Next.js to avoid large source maps
            // "exclude": [] // you can exclude files here if needed
          }
        ]
      ]
    }
  }
}
