{
  "name": "decibel-tribe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:seed": "tsup prisma/seed.ts --format esm --d dist --clean --target es2022",
    "build:seed:dating": "tsup prisma/seedDatingOnly.ts --format esm --d dist --clean --target es2022",
    "build:purge:test-users": "tsup prisma/purgeTestUsers.ts --format esm --d dist --clean --target es2022",
    "start": "next start",
    "postinstall": "npm run db:generate",
    "db:generate": "prisma generate",
    "db:seed": "npm run build:seed && node dist/seed.js",
    "db:seed:dating": "npm run build:seed:dating && node dist/seedDatingOnly.js",
    "db:purge:test-users": "npm run build:purge:test-users && node dist/purgeTestUsers.js",
    "dev:lint": "eslint .",
    "dev:lint:fix": "eslint --fix .",
    "dev:types:src": "tsc --noEmit",
    "dev:types:seed": "tsc --noEmit -p tsconfig.seed.json",
    "dev:types:vitest": "tsc -p vitest/tests/tsconfig.json --noEmit",
    "dev:check:types": "npm run dev:lint && npm run dev:types:src && npm run dev:types:seed && npm run dev:types:vitest",
    "dev:test:unit": "vitest run vitest/",
    "dev:test:unit:watch": "vitest vitest/",
    "dev:test:unit:ui": "vitest --ui vitest/",
    "dev:test:unit:coverage": "vitest run --coverage vitest/",
    "dev:test:seed": "vitest run prisma",
    "dev:test:all": "npm run dev:test:unit && npm run dev:test:seed",
    "dev:check:all": "npm run dev:check:types && npm run dev:test:all && npm run build",
    "cy:lint": "eslint cypress --ext .ts",
    "cy:types": "tsc -p cypress/tsconfig.json --noEmit",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:nightly:report": "npm run cy:prerun && cypress run --headless --reporter mochawesome --reporter-options reportDir=cypress/results,overwrite=false,html=false,json=true --quiet || true",
    "cy:prerun": "rm -rf cypress/results",
    "postcy:nightly:report": "npm run cy:report:merge",
    "cy:smoke": "cypress open --env grep=smoke,grepFilterSpecs=true",
    "cy:smoke:headless": "cypress run --env grep=smoke,grepFilterSpecs=true",
    "cy:report:merge": "mochawesome-merge cypress/results/*.json > cypress/results/output.json && npm run cy:report:generate",
    "cy:report:generate": "qa-shadow-report cypress ./cypress/results/output.json",
    "cy:check:all": "npm run cy:lint && npm run cy:types"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.1",
    "@hookform/resolvers": "^3.9.0",
    "@lucia-auth/adapter-prisma": "^4.0.1",
    "@million/lint": "^0.0.39",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tanstack/react-query": "^5.50.1",
    "@tanstack/react-query-devtools": "^5.50.1",
    "@tiptap/extension-placeholder": "^2.4.0",
    "@tiptap/pm": "^2.4.0",
    "@tiptap/react": "^2.4.0",
    "@tiptap/starter-kit": "^2.4.0",
    "@uploadthing/react": "^7.3.3",
    "arctic": "^1.9.1",
    "argon2": "^0.41.1",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "faker": "^5.5.3",
    "framer-motion": "^12.23.12",
    "ky": "^1.4.0",
    "lucia": "^3.2.0",
    "lucide-react": "^0.402.0",
    "next": "^15.5.7",
    "next-themes": "^0.3.0",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "qa-shadow-report": "^2.1.5",
    "react": "^19.2.1",
    "react-cropper": "^2.3.3",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.52.1",
    "react-image-file-resizer": "^0.4.8",
    "react-intersection-observer": "^9.10.3",
    "react-linkify-it": "^1.0.8",
    "react-select": "^5.8.0",
    "stream-chat": "^8.37.0",
    "stream-chat-react": "^13.13.1",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "uploadthing": "^7.7.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.10.0",
    "@cypress/grep": "^4.1.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.16.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-istanbul": "^3.1.1",
    "@vitest/ui": "^3.1.1",
    "babel-plugin-istanbul": "^7.0.0",
    "cypress": "^13.15.0",
    "cypress-axe": "^1.6.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.7",
    "eslint-config-prettier": "^9.1.0",
    "ignore-loader": "^0.1.2",
    "jest": "^29.7.0",
    "jsdom": "^25.0.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.4.1",
    "postcss": "^8",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "start-server-and-test": "^2.0.11",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^3.1.1",
    "vitest-mock-extended": "^3.1.0"
  }
}
