{
  "name": "decibel-tribe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "seed": "ts-node prisma/seed.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "cy:run:coverage": "start-server-and-test 'BABEL_ENV=instrumented next dev' http://localhost:3000 'npm run cypress:run'",
    "cypress:prerun": "rm -rf cypress/results && npm run seed",
    "cypress:run": "npm run cypress:prerun && cypress run --headless --reporter mochawesome --reporter-options reportDir=cypress/results,overwrite=false,html=false,json=true --quiet  || true",
    "postcypress:run": "npm run report:merge",
    "report:merge": "mochawesome-merge cypress/results/*.json > cypress/results/output.json && npm run report:generate",
    "report:generate": "qa-shadow-report cypress",
    "cypress:nightly": "npm run cypress:run",
    "cypress:open": "cypress open",
    "cypress:smoke": "cypress open --env grep=smoke,grepFilterSpecs=true",
    "cypress:smoke:headless": "cypress run --env grep=smoke,grepFilterSpecs=true"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.1",
    "@hookform/resolvers": "^3.9.0",
    "@lucia-auth/adapter-prisma": "^4.0.1",
    "@million/lint": "^1.0.14",
    "@prisma/client": "^5.16.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tanstack/react-query": "^5.50.1",
    "@tanstack/react-query-devtools": "^5.50.1",
    "@tiptap/extension-placeholder": "^2.4.0",
    "@tiptap/pm": "^2.4.0",
    "@tiptap/react": "^2.4.0",
    "@tiptap/starter-kit": "^2.4.0",
    "@uploadthing/react": "^6.7.2",
    "arctic": "^1.9.1",
    "argon2": "^0.41.1",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "faker": "^6.6.6",
    "ky": "^1.4.0",
    "lucia": "^3.2.0",
    "lucide-react": "^0.402.0",
    "next": "^14.2.26",
    "next-themes": "^0.3.0",
    "nodemailer": "^6.9.15",
    "prisma": "^5.16.1",
    "qa-shadow-report": "^1.1.31",
    "react": "^18.3.1",
    "react-cropper": "^2.3.3",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "react-image-file-resizer": "^0.4.8",
    "react-intersection-observer": "^9.10.3",
    "react-linkify-it": "^1.0.8",
    "react-select": "^5.8.0",
    "stream-chat": "^8.37.0",
    "stream-chat-react": "^11.23.0",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "uploadthing": "^6.13.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.14.0",
    "@cypress/grep": "^4.1.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^14.2.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-istanbul": "^3.1.1",
    "@vitest/ui": "^3.1.1",
    "babel-plugin-istanbul": "^7.0.0",
    "cypress": "^13.15.0",
    "eslint": "^8",
    "eslint-config-next": "^14.2.26",
    "eslint-config-prettier": "^9.1.0",
    "ignore-loader": "^0.1.2",
    "jest": "^29.7.0",
    "jsdom": "^25.0.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "postcss": "^8",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "start-server-and-test": "^2.0.11",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^3.1.1"
  }
}
