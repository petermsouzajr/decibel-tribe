{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "prisma",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "types": [],
    "noImplicitAny": true,
    "incremental": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": false
  },
  "include": ["prisma/**/*.ts"],
  "exclude": ["node_modules", "src", "cypress", "tests", "dist", "**/*.spec.ts"]
}
