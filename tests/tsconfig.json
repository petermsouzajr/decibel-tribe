{
  // Inherit settings from the root config
  "extends": "../tsconfig.json",

  "compilerOptions": {
    "baseUrl": "../",
    "paths": {
      "@/*": ["./src/*"]
    },
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "noEmit": true,

    "outDir": "../dist/tests"

    // Optional: You might not need 'noEmit' here if the root config has it,
    // but explicitly setting it won't hurt.
    // "noEmit": true
  },

  // Define what this config applies to (relative to this file)
  "include": [
    "./setupTests.ts", // Include setup file
    "./vitest.d.ts" // Include Vitest specific type definitions
    // Do NOT include ../src/**/* here, let the root tsconfig handle src checks
  ],

  "exclude": [
    "node_modules", // Exclude node_modules again
    "../cypress", // Exclude cypress folder
    "../node_modules",
    "../dist",
    "**/*.test.ts", // Exclude test files from this specific check
    "**/*.test.tsx" // Exclude test files from this specific check
  ]
}
